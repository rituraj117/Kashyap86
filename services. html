<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Services — BrandName</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:"Inter",sans-serif; background:#f8fafc; color:#0a0a0a; }
        .container { max-width:1200px; margin:0 auto; padding:0 24px; }
        a { text-decoration:none; color:inherit; }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid #e2e8f0;
        }
        .logo {
            font-size: 28px;
            font-weight: 700;
            background: linear-gradient(135deg, #6C63FF, #00D9FF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .nav { display:flex; gap:32px; align-items:center; }
        .nav a { font-weight:500; color:#1a1a1a; }
        .nav a:hover { color:#6C63FF; }
        .btn-primary {
            background:#6C63FF; color:#fff; padding:10px 24px;
            border-radius:40px; font-weight:600;
        }
        .btn-primary:hover { background:#5a52e0; }

        .services-hero {
            padding: 80px 0 40px;
            text-align: center;
        }
        .services-hero h1 { font-size:48px; font-weight:800; }

        .service-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 32px;
            padding: 40px 0;
        }
        .service-card {
            background: #fff;
            padding: 32px;
            border-radius: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.04);
            border: 1px solid #e2e8f0;
            transition: 0.2s;
        }
        .service-card:hover { border-color: #6C63FF; transform: translateY(-6px); }
        .service-card i { font-size:36px; color:#6C63FF; margin-bottom:12px; }
        .service-card h3 { font-size:22px; }
        .service-card p { color:#475569; margin:12px 0 16px; }
        .price { font-weight:700; font-size:20px; color:#0a0a0a; }

        footer {
            padding: 40px 0;
            text-align: center;
            color: #94a3b8;
            border-top: 1px solid #e2e8f0;
            margin-top: 40px;
        }
        .socials { display:flex; justify-content:center; gap:20px; margin-bottom:16px; }
        .socials a { color:#1a1a1a; font-size:20px; }
        .socials a:hover { color:#6C63FF; }

        @media (max-width:768px) { .nav { display:none; } }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <div class="logo">BrandName</div>
            <div class="nav">
                <a href="index.html">Home</a>
                <a href="about.html">About</a>
                <a href="services.html">Services</a>
                <a href="blog.html">Blog</a>
                <a href="contact.html" class="btn-primary">Contact</a>
            </div>
        </header>
    </div>

    <div class="container">
        <section class="services-hero">
            <h1>Our <span style="color:#6C63FF;">Services</span></h1>
            <p style="color:#475569;">Premium solutions to grow your brand and business.</p>
        </section>

        <div class="service-grid">
            <div class="service-card">
                <i class="fas fa-bullhorn"></i>
                <h3>Brand Strategy</h3>
                <p>Complete brand identity, positioning, and messaging.</p>
                <span class="price">₹9,999</span>
            </div>
            <div class="service-card">
                <i class="fas fa-laptop-code"></i>
                <h3>Website & Funnels</h3>
                <p>High-converting websites and sales funnels.</p>
                <span class="price">₹15,999</span>
            </div>
            <div class="service-card">
                <i class="fas fa-chart-pie"></i>
                <h3>Growth Marketing</h3>
                <p>SEO, ads, automation — all-in-one system.</p>
                <span class="price">₹12,499</span>
            </div>
            <div class="service-card">
                <i class="fas fa-robot"></i>
                <h3>AI Automation</h3>
                <p>AI-powered tools to automate your business.</p>
                <span class="price">₹19,999</span>
            </div>
        </div>
    </div>

    <footer>
        <div class="socials">
            <a href="#"><i class="fab fa-instagram"></i></a>
            <a href="#"><i class="fab fa-x-twitter"></i></a>
            <a href="#"><i class="fab fa-youtube"></i></a>
            <a href="#"><i class="fab fa-linkedin"></i></a>
        </div>
        <p>© 2026 BrandName. All rights reserved.</p>
    </footer>

</body>
</html>
