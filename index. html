    </footer>

    <!-- ===== WHATSAPP FLOATING BUTTON ===== -->
    <div style="position:fixed; bottom:24px; right:24px; z-index:999;">
        <a href="https://wa.me/919999999999?text=Hi!%20I%20want%20to%20know%20more"
           target="_blank"
           style="background:#25D366; color:#fff; padding:16px 20px; border-radius:60px; font-size:18px; font-weight:600; display:flex; align-items:center; gap:10px; box-shadow:0 8px 24px rgba(37,211,102,0.3);">
            <i class="fab fa-whatsapp" style="font-size:28px;"></i> Chat
        </a>
    </div>

    <!-- ===== POPUP ===== -->
    <div id="popup" style="display:none; position:fixed; bottom:120px; right:24px; background:var(--card-bg); padding:24px; border-radius:20px; box-shadow:0 20px 60px rgba(0,0,0,0.15); max-width:320px; z-index:999; border:1px solid var(--border);">
        <h4 style="margin-bottom:8px;">📩 Free Guide</h4>
        <p style="font-size:14px; color:#64748b; margin-bottom:16px;">Get our premium business guide — 100% free.</p>
        <input type="email" placeholder="Your email" style="width:100%; padding:10px; border-radius:12px; border:1px solid var(--border); background:var(--bg); color:var(--text); margin-bottom:10px;" />
        <button style="background:var(--primary); color:#fff; border:none; padding:10px; width:100%; border-radius:40px; font-weight:600;">Send Guide</button>
    </div>

    <!-- ===== SCRIPTS ===== -->
    <script>
        // ===== Dark Mode Toggle =====
        const toggle = document.getElementById('themeToggle');
        const html = document.documentElement;

        toggle.addEventListener('click', () => {
            const current = html.getAttribute('data-theme');
            if (current === 'dark') {
                html.removeAttribute('data-theme');
                toggle.textContent = '🌙';
            } else {
                html.setAttribute('data-theme', 'dark');
                toggle.textContent = '☀️';
            }
        });

        // ===== Popup Show =====
        setTimeout(() => {
            document.getElementById('popup').style.display = 'block';
        }, 5000);

        // ===== Live Visitor Counter =====
        let count = 12847;
        setInterval(() => {
            count += Math.floor(Math.random() * 3);
            document.getElementById('visitorCount').textContent = count.toLocaleString();
        }, 3000);
    </script>

